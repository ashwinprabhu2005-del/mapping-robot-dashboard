# AMR Docker Infrastructure - Default Environment Variables for Testing
# Change these values in production!

# PostgreSQL
POSTGRES_USER=amr_user
POSTGRES_PASSWORD=amr_password

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=influx_password
INFLUXDB_TOKEN=influx_token_long_default_token_of_length_at_least_32_characters

# MQTT Passwords (per user)
MQTT_AMR_ROBOT_PASSWORD=amr_password
MQTT_DATA_ROUTER_PASSWORD=router_password
MQTT_ROSBRIDGE_PASSWORD=bridge_password
MQTT_DASHBOARD_PASSWORD=dashboard_password

# Docker host IP
DOCKER_HOST_IP=localhost

# Domain
DOMAIN=localhost
