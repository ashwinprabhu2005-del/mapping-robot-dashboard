# AMR Docker Infrastructure - Environment Variables
# Copy this to .env and fill in your values!

# PostgreSQL
POSTGRES_USER=amr_user
POSTGRES_PASSWORD=change_me_postgres_password

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_TOKEN=change_me_influx_token

# MQTT Passwords (per user)
MQTT_AMR_ROBOT_PASSWORD=change_me_robot_password
MQTT_DATA_ROUTER_PASSWORD=change_me_router_password
MQTT_ROSBRIDGE_PASSWORD=change_me_bridge_password
MQTT_DASHBOARD_PASSWORD=change_me_dashboard_password

# Docker host IP (shown to Jetson Nano)
DOCKER_HOST_IP=192.168.1.100

# Domain (if using domain name)
DOMAIN=localhost
